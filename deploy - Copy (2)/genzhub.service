# systemd unit: /etc/systemd/system/genzhub.service
[Unit]
Description=Gen-Z Hub social platform
After=network.target

[Service]
Type=simple
User=genzhub
WorkingDirectory=/opt/genzhub
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/genzhub
EnvironmentFile=-/etc/genzhub.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/genzhub

[Install]
WantedBy=multi-user.target
