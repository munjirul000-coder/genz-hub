# Gen-Z Hub environment configuration (never commit real values)
PORT=3000
DATA_DIR=./data
ADMIN_EMAIL=admin@genzhub.app
ADMIN_PASSWORD=change-this-strong-password

# NOVA — optional advanced server-side AI provider (never commit keys)
# Most users can skip this file: connect Groq inside NOVA → Settings → Intelligence.
# Groq preset:
# NOVA_AI_PROVIDER=groq
# NOVA_AI_API_KEY=gsk_your_key_here
# NOVA_AI_MODEL=llama-3.3-70b-versatile
#
# OpenAI preset:
# NOVA_AI_PROVIDER=openai
# NOVA_AI_API_KEY=
# NOVA_AI_MODEL=gpt-4.1-mini
#
# Custom OpenAI-compatible endpoint:
# NOVA_AI_BASE_URL=https://api.openai.com/v1
# For a local Ollama server: NOVA_AI_BASE_URL=http://127.0.0.1:11434/v1
# NOVA_AI_ALLOW_UNAUTHENTICATED=1
# NOVA_HOME=1
