# ── IdeaPulse configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the server listens on
PORT=3000

# Directory where the SQLite database is stored (created automatically)
DATA_DIR=./data

# Set to "production" when deploying behind HTTPS
NODE_ENV=production

# Secret used to sign session cookies. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin account (created automatically on first boot if the table is empty)
ADMIN_EMAIL=admin@ideapulse.app
ADMIN_PASSWORD=change-this-strong-password

# Public base URL (used in sitemap / canonical links, optional)
CANONICAL_HOST=
