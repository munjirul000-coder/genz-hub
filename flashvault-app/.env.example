# FlashVault BD - Production Environment Variables
# Copy this to .env.local for local dev, or set in Vercel/Render dashboard

# === DATABASE (Required for real users - prevents data loss) ===
# Get free Postgres from Supabase (https://supabase.com) or Neon (https://neon.tech)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/flashvault?sslmode=require"

# === AUTH & SECURITY (Required) ===
JWT_SECRET="generate_strong_random_string_min_32_chars_change_this_in_prod"
AUTH_SECRET="same_as_jwt_secret_or_different_strong_string"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Super Admin - First admin creation (required for production, no hardcoded fallback)
SUPER_ADMIN_EMAIL="admin@flashvault.bd"
SUPER_ADMIN_PASSWORD="StrongPassword@123_min_8_chars"
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PHONE="01700000000"

# === IMAGE STORAGE (Required for real users - prevents image loss) ===
# Option 1: Cloudinary (Recommended for students - FREE 25GB)
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# OR use unsigned upload preset (easier, no secret needed in server)
CLOUDINARY_UPLOAD_PRESET="flashvault_unsigned_preset"

# Option 2: Cloudflare R2 (Cheapest long term - FREE 10GB, no egress fee)
# Get from Cloudflare Dashboard > R2
R2_ACCOUNT_ID="your_account_id"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET="flashvault"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev or https://images.yourdomain.com"

# Option 3: AWS S3 (If you have AWS)
AWS_ACCESS_KEY_ID="your_aws_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret"
AWS_S3_BUCKET="flashvault-bd"
AWS_REGION="ap-south-1"
AWS_S3_PUBLIC_URL="https://your-bucket.s3.amazonaws.com"

# === PAYMENT GATEWAYS (Optional - for real bKash/SSLCommerz) ===
# bKash - Get from bKash Merchant Dashboard
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"
BKASH_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"

# SSLCommerz - Get from https://developer.sslcommerz.com/
SSLCOMMERZ_STORE_ID="your_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_store_password"
SSLCOMMERZ_IS_LIVE="false" # true for production

# === EMAIL (Optional - for password reset) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="FlashVault <noreply@flashvault.bd>"

# === OPTIONAL ===
NODE_ENV="production"
