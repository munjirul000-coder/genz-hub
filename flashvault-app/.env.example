# FlashVault BD - Production Env Vars
# Legacy admin keys (still supported for backward compat, but JWT preferred)
ADMIN_KEY=FLASHVAULT2026
SUPER_ADMIN_KEY=FLASHVAULT_SUPER_2026

# Auth - JWT & Super Admin Creation (SAFE - no hardcoded password in code)
JWT_SECRET=change_this_to_random_64_char_string_in_prod
AUTH_SECRET=change_this_to_random_64_char_string_in_prod

# First SUPER_ADMIN - set these in Render env to auto-create on first deploy
# No hardcoded password in source code - must come from env
SUPER_ADMIN_EMAIL=admin@flashvault.bd
SUPER_ADMIN_PASSWORD=ChangeMe123!StrongPass
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=01700000000

# Platform
PLATFORM_NAME=FlashVault BD
PLATFORM_TIMEZONE=Asia/Dhaka
COMMISSION_PERCENT=10
NEXT_PUBLIC_SITE_URL=https://flashvault-bd.onrender.com

# Optional - for future payment integration
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# PATHAO_API_KEY=

# Optional - SEO
# GOOGLE_SITE_VERIFICATION=

# Node
NODE_ENV=production
