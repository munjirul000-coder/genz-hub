{
  "name": "flashvault-bd",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "build": "prisma db push --skip-generate || echo '[build] prisma db push skipped (no DATABASE_URL?)' ; next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "lint": "next lint",
    "postinstall": "prisma generate || echo 'prisma generate skipped - no DATABASE_URL or network'"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.21",
    "lucide-react": "^0.424.0",
    "next": "14.2.5",
    "nodemailer": "^10.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}